# Copy this file to .env.local when running the frontend in GitHub Codespaces.
# VITE_CODESPACE_NAME must be defined so the frontend can call:
# https://${VITE_CODESPACE_NAME}-8000.app.github.dev/api/[component]/
# Leave it unset for local development; the app falls back to http://localhost:8000/api.
VITE_CODESPACE_NAME=your-codespace-name
